
#include <iostream>
#include <climits>
using namespace std;

int main()
{
    int n;
    int cost[100][100];
    int visited[100] = {0};

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter adjacency matrix:\n";

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cin >> cost[i][j];

            if (cost[i][j] == 0)
                cost[i][j] = INT_MAX;
        }
    }

    visited[0] = 1;

    int edges = 0;
    int minCost = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    while (edges < n - 1)
    {
        int min = INT_MAX;
        int a = -1, b = -1;

        for (int i = 0; i < n; i++)
        {
            if (visited[i])
            {
                for (int j = 0; j < n; j++)
                {
                    if (!visited[j] && cost[i][j] < min)
                    {
                        min = cost[i][j];
                        a = i;
                        b = j;
                    }
                }
            }
        }

        if (a == -1)
        {
            cout << "Graph is not connected.";
            return 0;
        }

        cout << a << " - " << b
             << " : " << min << endl;

        minCost += min;
        visited[b] = 1;
        edges++;
    }

    cout << "\nMinimum Cost = " << minCost;

    return 0;
}
