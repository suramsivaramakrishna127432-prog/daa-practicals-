
#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
    int n, W;

    cout << "Enter number of items: ";
    cin >> n;

    int wt[100], profit[100];

    cout << "Enter weights of items:\n";
    for (int i = 1; i <= n; i++)
        cin >> wt[i];

    cout << "Enter profits of items:\n";
    for (int i = 1; i <= n; i++)
        cin >> profit[i];

    cout << "Enter knapsack capacity: ";
    cin >> W;

    int dp[101][1001] = {0};

    for (int i = 1; i <= n; i++)
    {
        for (int w = 0; w <= W; w++)
        {
            if (wt[i] <= w)
            {
                dp[i][w] = max(
                    dp[i-1][w],
                    profit[i] + dp[i-1][w-wt[i]]
                );
            }
            else
            {
                dp[i][w] = dp[i-1][w];
            }
        }
    }

    cout << "\nMaximum Profit = " << dp[n][W];

    return 0;
}
