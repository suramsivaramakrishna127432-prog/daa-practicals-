
#include <iostream>
#include <algorithm>
using namespace std;

struct Edge
{
    int src, dest, weight;
};

int parent[100];

int find(int i)
{
    if (parent[i] == i)
        return i;

    return parent[i] = find(parent[i]);
}

void Union(int x, int y)
{
    int rootX = find(x);
    int rootY = find(y);

    parent[rootX] = rootY;
}

int main()
{
    int V, E;

    cout << "Enter number of vertices: ";
    cin >> V;

    cout << "Enter number of edges: ";
    cin >> E;

    Edge edges[100];

    cout << "Enter source, destination and weight:\n";

    for (int i = 0; i < E; i++)
    {
        cin >> edges[i].src
            >> edges[i].dest
            >> edges[i].weight;
    }

    // Sort edges by weight
    sort(edges, edges + E,
         [](Edge a, Edge b)
         {
             return a.weight < b.weight;
         });

    // Initialize parent array
    for (int i = 0; i < V; i++)
        parent[i] = i;

    int totalCost = 0;
    int count = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    for (int i = 0; i < E && count < V - 1; i++)
    {
        int u = edges[i].src;
        int v = edges[i].dest;

        int setU = find(u);
        int setV = find(v);

        if (setU != setV)
        {
            cout << u << " - " << v
                 << " : " << edges[i].weight << endl;

            totalCost += edges[i].weight;

            Union(setU, setV);
            count++;
        }
    }

    if (count != V - 1)
    {
        cout << "Graph is not connected.";
    }
    else
    {
        cout << "\nMinimum Cost = " << totalCost;
    }

    return 0;
}
